{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "./dist/server",
    "rootDir": "./src",
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src/shared/**/*.ts", "src/server/**/*.ts"],
  "exclude": ["src/client/**/*", "tests/**/*"]
}
