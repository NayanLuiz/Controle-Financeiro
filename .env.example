# Server runtime configuration
NODE_ENV=development
PORT=3000

# Single-user authentication credentials (RNF-2, RNF-6)
# Replace both values before running in production.
# Generate a strong secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_PASSWORD=change-me-strong-password
SESSION_SECRET=change-me-32-chars-minimum-secret-key

# SQLite WAL database file path (RNF-4, RNF-6)
# Local development default: ./data/finance.db
# Production container volume default: /data/finance.db
DATABASE_PATH=./data/finance.db
