{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "entry": [
    "src/server/index.ts!",
    "src/client/main.tsx!",
    "src/shared/contracts/index.ts",
    "src/shared/domain/*.ts",
    "tests/**/*.test.ts",
    "tests/**/*.test.tsx",
    "vite.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"],
  "ignoreDependencies": ["@testing-library/jest-dom"]
}
