{
  "name": "personal-finance",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Finance Control PWA — Single-user full-stack monolith",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/server/index.js",
    "format": "biome check --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "deadcode": "knip --no-progress",
    "duplication": "jscpd src tests",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run deadcode && npm run duplication && npm run test"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/static": "8.1.0",
    "fastify": "5.2.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@types/node": "22.13.4",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "jscpd": "4.0.5",
    "jsdom": "26.0.0",
    "knip": "5.46.0",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vite": "6.2.0",
    "vitest": "3.0.8"
  }
}
